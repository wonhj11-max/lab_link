{
  "name": "lab-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "test": "node --test pipeline/*.test.mjs",
    "crawl:dry": "node pipeline/worker.mjs --dry-run",
    "crawl": "node pipeline/worker.mjs",
    "papers:list": "node pipeline/review.mjs list",
    "papers:discover": "node pipeline/discover-papers.mjs"
    ,"papers:scale": "node pipeline/scale-publications.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
